<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_estate_doc_gen_wizard_form" model="ir.ui.view">
        <field name="name">estate.doc.gen.wizard.form</field>
        <field name="model">estate.doc.gen.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Legal Document">
                <group>
                    <group>
                        <field name="doc_type"/>
                        <field name="feasibility_id"/>
                        <field name="partner_id"/>
                    </group>
                    <group>
                        <field name="execution_date"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="agreed_amount"/>
                    </group>
                </group>
                <group string="Special Terms &amp; Clauses">
                    <field name="special_terms" placeholder="Enter custom terms to include in agreement..."/>
                </group>
                <footer>
                    <button string="Generate Document PDF" name="action_generate_document" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_estate_doc_gen_wizard" model="ir.actions.act_window">
        <field name="name">Generate Legal Document</field>
        <field name="res_model">estate.doc.gen.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
