<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_estate_sanction_tree" model="ir.ui.view">
        <field name="name">estate.sanction.list</field>
        <field name="model">estate.sanction</field>
        <field name="arch" type="xml">
            <list string="Sanctions &amp; Approvals">
                <field name="name"/>
                <field name="project_id"/>
                <field name="sanction_type"/>
                <field name="reference_no"/>
                <field name="authority_name"/>
                <field name="issue_date"/>
                <field name="expiration_date"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'expiring_soon'" decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="view_estate_sanction_form" model="ir.ui.view">
        <field name="name">estate.sanction.form</field>
        <field name="model">estate.sanction</field>
        <field name="arch" type="xml">
            <form string="Sanction / Approval">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,expiring_soon,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Building Commencement Certificate Phase 1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="sanction_type"/>
                            <field name="reference_no"/>
                            <field name="authority_name"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiration_date"/>
                            <field name="document" filename="filename"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                    <group string="Notes &amp; Conditions">
                        <field name="notes" placeholder="Special conditions imposed by authority..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_estate_sanction" model="ir.actions.act_window">
        <field name="name">Sanctions &amp; Approvals</field>
        <field name="res_model">estate.sanction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
